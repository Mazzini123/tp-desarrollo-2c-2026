SERVER_PORT=8000
# El Mongo de docker-compose es un replica set de un nodo (hace falta para las
# transacciones). Desde fuera de Docker se conecta directo al nodo:
MONGO_URI=mongodb://localhost:27017/codigo-a-voluntad?directConnection=true
# Autenticacion con Logto (la API valida el JWT: emisor <endpoint>/oidc, audiencia LOGTO_API_RESOURCE).
# Sin estas dos variables la API NO arranca. Para desarrollar sin login hay que
# usar NODE_ENV=development y AUTH_DESACTIVADA=true.
# NODE_ENV=development
# AUTH_DESACTIVADA=true
# LOGTO_ENDPOINT=https://tu-tenant.logto.app
# LOGTO_API_RESOURCE=https://api.codigo-a-voluntad
# Algoritmos de firma aceptados (los que publica <endpoint>/oidc/jwks).
# LOGTO_ALGORITMOS=ES384
#
# Varios proveedores: un JSON con una entrada por proveedor. Reemplaza a las LOGTO_*.
# AUTH_PROVEEDORES=[{"codigo":"logto","nombre":"Logto","mecanismo":"OIDC_JWT","issuers":["https://tu-tenant.logto.app/oidc"],"audiencia":"https://api.codigo-a-voluntad","jwksUri":"https://tu-tenant.logto.app/oidc/jwks","algoritmos":["ES384"]}]
#
# Transitorio: acepta pedidos sin X-Context-Id cuando el usuario tiene un solo
# contexto valido y es el actual. Se apaga cuando el front manda el encabezado.
# COMPAT_CONTEXTO_IMPLICITO=true
#
# Origenes del front habilitados por CORS, separados por coma (sin esto se acepta cualquiera).
# CORS_ORIGENES=http://localhost:5173

# Opcional: servidor SMTP para replicar las notificaciones por email.
# Sin esto, los emails se simulan (solo se registran en el log).
# Ejemplo: SMTP_URL=smtps://usuario:clave@smtp.gmail.com:465
# SMTP_URL=
# SMTP_REMITENTE=Codigo a Voluntad <no-responder@tu-dominio>

# Opcional: credenciales de Twilio para enviar notificaciones de WhatsApp reales.
# Sin esto, los mensajes de WhatsApp se simulan y solo quedan en el log de la api.
# TWILIO_ACCOUNT_SID=ACXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
# TWILIO_AUTH_TOKEN=tu_token_secreto_de_twilio
# TWILIO_WHATSAPP_REMITENTE=whatsapp:+12345678910

# Opcional: limites de solicitudes por IP (rate limiting).
# LIMITE_SOLICITUDES_GENERAL=300     # por IP cada 15 minutos
# LIMITE_SOLICITUDES_BUSQUEDAS=30    # por IP por minuto, en busquedas y estadisticas

# Opcional: cada cuanto se buscan proyectos con la fecha de cierre vencida.
# CIERRE_AUTOMATICO_INTERVALO_MS=60000

# Opcional: cada cuanto se mandan los emails/WhatsApp/SMS pendientes de las notificaciones.
# ENVIOS_INTERVALO_MS=15000

# Apagado ordenado: inferior al stop_grace_period del contenedor (30 s).
# APAGADO_PLAZO_MS=25000
# Solo proxies conocidos por IP/CIDR; omitir si la API recibe conexiones directas.
# TRUST_PROXY=127.0.0.1,10.0.0.0/8
