SERVER_PORT=8000
MONGO_URI=mongodb://localhost:27017/codigo-a-voluntad
# Autenticacion con Logto (la API valida el JWT: emisor <endpoint>/oidc, audiencia LOGTO_API_RESOURCE).
# Sin estas dos variables la API corre SIN autenticacion (solo para desarrollo y tests);
# con NODE_ENV=production no arranca sin ellas, salvo AUTH_DESACTIVADA=true.
# LOGTO_ENDPOINT=https://tu-tenant.logto.app
# LOGTO_API_RESOURCE=https://api.codigo-a-voluntad

# Opcional: servidor SMTP para replicar las notificaciones por email.
# Sin esto, los emails se simulan (solo se registran en el log).
# Ejemplo: SMTP_URL=smtps://usuario:clave@smtp.gmail.com:465
# SMTP_URL=
# SMTP_REMITENTE=Codigo a Voluntad <no-responder@tu-dominio>

# Opcional: credenciales de Twilio para enviar notificaciones de WhatsApp reales.
# Sin esto, los mensajes de WhatsApp se simulan y solo quedan en el log de la api.
# TWILIO_ACCOUNT_SID=ACXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
# TWILIO_AUTH_TOKEN=tu_token_secreto_de_twilio
# TWILIO_WHATSAPP_REMITENTE=whatsapp:+12345678910

# Opcional: limites de solicitudes por IP (rate limiting).
# LIMITE_SOLICITUDES_GENERAL=300     # por IP cada 15 minutos
# LIMITE_SOLICITUDES_BUSQUEDAS=30    # por IP por minuto, en busquedas y estadisticas

# Opcional: cada cuanto se buscan proyectos con la fecha de cierre vencida.
# CIERRE_AUTOMATICO_INTERVALO_MS=60000
