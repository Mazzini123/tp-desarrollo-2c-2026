SERVER_PORT=8000
MONGO_URI=mongodb://localhost:27017/codigo-a-voluntad
# Opcional: servidor SMTP para replicar las notificaciones por email.
# Sin esto, los emails se simulan (solo se registran en el log).
# Ejemplo: SMTP_URL=smtps://usuario:clave@smtp.gmail.com:465
# SMTP_URL=
# SMTP_REMITENTE=Codigo a Voluntad <no-responder@tu-dominio>

# Opcional: limites de solicitudes por IP (rate limiting).
# LIMITE_SOLICITUDES_GENERAL=300     # por IP cada 15 minutos
# LIMITE_SOLICITUDES_BUSQUEDAS=30    # por IP por minuto, en busquedas y estadisticas
