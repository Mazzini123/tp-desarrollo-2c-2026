@startuml

' ───────────────────────── Colectivo y Ubicación ─────────────────────────

class Colectivo {
  -nombre: string
  -descripcion: string
  -tipoColectivo: TIPO_COLECTIVO
  -ubicacion: Ubicacion
  -redesSociales: Array<RedSocial>
  -etiquetas: Array<string>
  -mediosDeContacto: Array<MedioDeContacto>
  -fechaAlta: Date
  -fechaBaja: Date

  +estaDadoDeBaja(): boolean
  +darDeBaja(fecha: Date): void
  +tieneMedioDeContacto(medio: MedioDeContacto): boolean
  +agregarMedioDeContacto(medio: MedioDeContacto): void
  +quitarMedioDeContacto(medio: MedioDeContacto): void
}

enum TIPO_COLECTIVO {
  FUNDACION
  ASOCIACION_BARRIAL
  ONG
  ASAMBLEA
}

class Ubicacion {
  -tipoUbicacion: TIPO_UBICACION
  -nombre: string

}

enum TIPO_UBICACION {
  ARGENTINA
  PROVINCIA
  CABA
  LOCALIDAD
}

class RedSocial {
  -nombre: string
  -url: string
}

Colectivo --> TIPO_COLECTIVO
Colectivo --> "0..1" Ubicacion
Colectivo --> "*" RedSocial
Colectivo --> "*" MedioDeContacto
Ubicacion --> TIPO_UBICACION

' ───────────────────────── Proyecto, logros y avances ─────────────────────────

class Proyecto {
  -colectivo: Colectivo
  -titulo: string
  -descripcion: string
  -estado: PROYECTO_ESTADO
  -perfiles: Array<Perfil>
  -colaboraciones: Array<Colaboracion>
  -porcentajeConcrecion: number
  -urlSistema: string
  -urlRepositorio: string
  -logros: Array<Logro>
  -avances: Array<Avance>
  -etiquetas: Array<string>
  -fechaCreacion: Date
  -fechaFinalizacion: Date
  -fechaCierre: Date
  -visualizaciones: number

  +estaAbierto(): boolean
  +finalizarProyecto(fecha: Date): void
  +agregarPerfil(perfil: Perfil): void
  +quitarPerfil(perfil: Perfil): void
  +buscarPerfil(perfilId: string): Perfil
  +yaColaboraron(colaborador: Colaborador): boolean
  +agregarColaboracion(colaboracion: Colaboracion): void
  +buscarColaboracion(colaboracionId: string): Colaboracion
  +colaboracionesPendientes(): Array<Colaboracion>
  +cantidadAceptadas(perfil: Perfil): number
  +agregarLogro(logro: Logro): void
  +quitarLogro(logro: Logro): void
  +agregarAvance(avance: Avance): void
  +ultimoAvance(): Avance
}

enum PROYECTO_ESTADO {
  ABIERTO
  FINALIZADO
}

class Logro {
  -titulo: string
  -descripcion: string
  -fecha: Date
}

class Avance {
  -porcentajeConcrecion: number
  -urlSistema: string
  -urlRepositorio: string
  -fecha: Date
}

Proyecto --> "1" Colectivo
Proyecto --> PROYECTO_ESTADO
Proyecto --> "1..*" Perfil
Proyecto --> "*" Colaboracion
Proyecto --> "*" Logro
Proyecto --> "*" Avance

' ───────────────────────── Perfil y Compromiso ─────────────────────────

class Perfil {
  -titulo: string
  -busquedaAbierta: boolean
  -descripcion: string
  -fechaCierreBusqueda: Date
  -habilidadesRequeridas: Array<Habilidad>
  -habilidadesOpcionales: Array<Habilidad>
  -compromiso: Compromiso
  -limiteColaboraciones: number
  -modalidadColaboracion: MODALIDAD_COLABORACION
  -modoAceptacion: MODO_ACEPTACION

  +tieneHabilidad(lista: Array<Habilidad>, habilidad: Habilidad): boolean
  +tieneHabilidadRequerida(habilidad: Habilidad): boolean
  +tieneHabilidadOpcional(habilidad: Habilidad): boolean
  +agregarHabilidadRequerida(habilidad: Habilidad): void
  +quitarHabilidadRequerida(habilidad: Habilidad): void
  +agregarHabilidadOpcional(habilidad: Habilidad): void
  +quitarHabilidadOpcional(habilidad: Habilidad): void
  +codigosRequeridos(): Array<string>
  +codigosOpcionales(): Array<string>
  +tieneLimite(): boolean
  +limiteAlcanzado(cantidadAceptadas: number): boolean
}

class Compromiso {
  -cantidadHoras: number
  -periodo: PERIODO_COMPROMISO
}

enum PERIODO_COMPROMISO {
  HS_TOTALES
  HS_SEMANALES
  HS_MENSUALES
}

enum MODALIDAD_COLABORACION {
  GRATUITA
  OFRECE_INCENTIVO_ECONOMICO
  EXISTE_POSIBILIDAD_DE_CONTRATACION
}

enum MODO_ACEPTACION {
  REVISION_MANUAL
  TODO_SUMA
  HASTA_LLENAR_VACANTES
}

class Habilidad {
  -titulo: string
  -codigo: string
  -descripcion: string
  -fechaCreacion: Date
  -usuario: string
  -activo: boolean

  +equals(otra: Habilidad): boolean
}

Perfil --> Compromiso
Perfil --> MODALIDAD_COLABORACION
Perfil --> MODO_ACEPTACION
Perfil --> "1..*" Habilidad : requeridas
Perfil --> "*" Habilidad : opcionales
Compromiso --> PERIODO_COMPROMISO

' ───────────────────────── Colaboración y valoraciones ─────────────────────────

class Colaboracion {
  -proyecto: Proyecto
  -colaborador: Colaborador
  -perfil: Perfil
  -esPublica: boolean
  -fecha: Date
  -estado: COLABORACION_ESTADO
  -fechaResolucion: Date
  -fechaFin: Date
  -valoracionDelColectivo: Valoracion
  -valoracionDelColaborador: Valoracion

  +estaPendiente(): boolean
  +estaAceptada(): boolean
  +estaFinalizada(): boolean
  +estaRetirada(): boolean
  +esDe(colaborador: Colaborador): boolean
  +aceptar(fecha: Date): void
  +rechazar(fecha: Date): void
  +finalizar(fecha: Date): void
  +desvincular(fecha: Date): void
  +retirar(fecha: Date): void
}

enum COLABORACION_ESTADO {
  PENDIENTE
  ACEPTADA
  RECHAZADA
  FINALIZADA
  DESVINCULADA
  RETIRADA
}

class Valoracion {
  -puntaje: number
  -comentario: string
  -fecha: Date
}

Colaboracion --> Proyecto
Colaboracion --> Colaborador
Colaboracion --> Perfil
Colaboracion --> COLABORACION_ESTADO
Colaboracion --> "0..1" Valoracion : delColectivo
Colaboracion --> "0..1" Valoracion : delColaborador

' ───────────────────────── Colaborador y contacto ─────────────────────────

class Colaborador {
  -nombreFantasia: string
  -nombre: string
  -apellido: string
  -cuentaGit: string
  -pronombres: Array<string>
  -presentacion: string
  -habilidades: Array<Habilidad>
  -recibeMensajeriaInterna: boolean
  -mediosDeContacto: Array<MedioDeContacto>
  -redesSociales: Array<RedSocial>
  -fechaBaja: Date

  +estaDadaDeBaja(): boolean
  +darDeBaja(fecha: Date): void
  +tienePronombre(pronombre: string): boolean
  +agregarPronombre(pronombre: string): void
  +quitarPronombre(pronombre: string): void
  +reemplazarPronombres(pronombres: Array<string>): void
  +tieneHabilidad(habilidad: Habilidad): boolean
  +agregarHabilidad(habilidad: Habilidad): void
  +quitarHabilidad(habilidad: Habilidad): void
  +tieneMedioDeContacto(medio: MedioDeContacto): boolean
  +agregarMedioDeContacto(medio: MedioDeContacto): void
  +quitarMedioDeContacto(medio: MedioDeContacto): void
  +nombreParaMostrar(): string
}

class MedioDeContacto {
  -tipo: TIPOS_MEDIOS_CONTACTO
  -valor: string

  +equals(otro: MedioDeContacto): boolean
}

enum TIPOS_MEDIOS_CONTACTO {
  SMS
  EMAIL
  WHATSAPP
}

Colaborador --> "*" Habilidad
Colaborador --> "*" MedioDeContacto
Colaborador --> "*" RedSocial
MedioDeContacto --> TIPOS_MEDIOS_CONTACTO

' ───────────────────────── Notificaciones ─────────────────────────

class NotificacionInterna {
  -destinatario: Colaborador
  -tipo: TIPO_NOTIFICACION
  -asunto: string
  -contenido: string
  -referencias: object
  -fecha: Date
  -esLeida: boolean

  +marcarComoLeida(): void
  +esPara(colaboradorId: string): boolean
}

enum TIPO_NOTIFICACION {
  INVITACION
  PROYECTOS_COMPATIBLES
  POSTULACION_ACEPTADA
  POSTULACION_RECHAZADA
  COLABORACION_FINALIZADA
  DESVINCULACION
}

NotificacionInterna --> TIPO_NOTIFICACION
NotificacionInterna --> Colaborador

@enduml
