# Variables para docker-compose.prod.yml. En la VM:
#
#   cp .env.prod.example .env
#   nano .env        # completar con valores reales
#   chmod 600 .env   # que solo lo lea tu usuario
#
# .env esta en el .gitignore: NUNCA commitear la contraseña real.
#
# Usar solo letras y numeros en la contraseña: va adentro de la URI de
# conexion, y caracteres como @ : / % la rompen. Para generar una:
#
#   openssl rand -hex 24

MONGO_USER=cav_admin
MONGO_PASSWORD=cambiar-por-una-contraseña-generada

# La API requiere LOGTO_ENDPOINT y LOGTO_API_RESOURCE o AUTH_PROVEEDORES.
LOGTO_ENDPOINT=https://tu-tenant.logto.app
LOGTO_API_RESOURCE=https://api.codigo-a-voluntad
# LOGTO_ALGORITMOS=ES384
# AUTH_PROVEEDORES reemplaza las variables LOGTO_* (ver packages/backend/.env.example).
# COMPAT_CONTEXTO_IMPLICITO=false

# Obligatoria: origen (o origenes, separados por coma) del front.
CORS_ORIGENES=https://tu-dominio-del-front

# Opcional: servidor SMTP para replicar las notificaciones por email.
# Sin esto, los emails se simulan y solo quedan en el log de la api.
# SMTP_URL=smtps://usuario:clave@smtp.ejemplo.com:465
# SMTP_REMITENTE=Codigo a Voluntad <no-responder@ejemplo.com>

# Opcional: credenciales de Twilio para enviar notificaciones reales por WhatsApp.
# Sin esto, los mensajes de WhatsApp se simulan y solo quedan en el log de la api.
# TWILIO_ACCOUNT_SID=ACXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
# TWILIO_AUTH_TOKEN=tu_token_secreto_de_twilio
# TWILIO_WHATSAPP_REMITENTE=whatsapp:+12345678910

# Opcional: remitente habilitado para SMS (requiere ambas credenciales Twilio).
# Sin esta variable SMS se simula, independientemente de WhatsApp.
# TWILIO_SMS_REMITENTE=+12345678910

# Apagado ordenado: inferior al stop_grace_period del contenedor (30 s).
# APAGADO_PLAZO_MS=25000
# Solo proxies conocidos por IP/CIDR; omitir si la API recibe conexiones directas.
# TRUST_PROXY=127.0.0.1,10.0.0.0/8
